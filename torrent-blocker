#!/usr/bin/env bash
set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]:-$0}"
SCRIPT_PATH="$(readlink -f "$SCRIPT_SOURCE" 2>/dev/null || echo "$SCRIPT_SOURCE")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"

APP_DIR="${TORRENT_BLOCKER_APP_DIR:-$SCRIPT_DIR}"
source "${SCRIPT_DIR}/common.sh"
ENV_FILE="${APP_DIR}/.env"
APP_SCRIPT="${APP_DIR}/torrent-blocker"
LAST_ID_FILE="${APP_DIR}/last_id"
LOCK_FILE="${APP_DIR}/torrent-blocker.lock"
STATE_DIR="${TORRENT_BLOCKER_STATE_DIR:-/var/lib/torrent-blocker}"
FIREWALL_LOCK="${TORRENT_BLOCKER_FIREWALL_LOCK:-/run/lock/torrent-blocker-firewall.lock}"
BANS_FILE="${STATE_DIR}/bans.json"

TABLE="torrent_guard"
SET="blocked_ipv4"
CHAIN="input"

REQUIRED_COMMANDS=("curl" "jq" "nft" "logger" "flock")

check_required_commands() {
  local cmd

  for cmd in "${REQUIRED_COMMANDS[@]}"; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo "Ошибка: не найдена команда: $cmd"
      echo "Установи зависимости: apt install -y curl jq nftables util-linux"
      exit 1
    fi
  done
}

ensure_app_dir() {
  if [[ ! -d "$APP_DIR" ]]; then
    echo "Ошибка: не найдена директория: $APP_DIR"
    exit 1
  fi
}

default_ingress_node_name() {
  local host_name ip_address

  host_name="$(hostname 2>/dev/null || echo "unknown-host")"
  read -r ip_address _ < <(hostname -I 2>/dev/null || true) || true

  if [[ -n "${ip_address:-}" ]]; then
    echo "${host_name} (${ip_address})"
  else
    echo "$host_name"
  fi
}

acquire_lock() {
  exec 9>"$LOCK_FILE"

  if ! flock -n 9; then
    echo "Torrent Blocker уже запущен, текущий запуск пропущен"
    exit 0
  fi
}

load_runtime_config() {
  if [[ ! -f "$ENV_FILE" ]]; then
    echo "Ошибка: не найден файл конфигурации: $ENV_FILE"
    exit 1
  fi

  load_config_file "$ENV_FILE" || return 1

  INSTANCE_NAME="${INSTANCE_NAME:-default}"
  SERVICE_UNIT="${SERVICE_UNIT:-torrent-blocker.service}"
  TIMER_UNIT="${TIMER_UNIT:-torrent-blocker.timer}"
  MENU_BIN="${MENU_BIN:-/usr/local/bin/torrent-blocker}"

  BAN_TIMEOUT="${BAN_TIMEOUT:-1h}"
  PAGE_SIZE="${PAGE_SIZE:-100}"
  MAX_PAGES="${MAX_PAGES:-5}"
  INGRESS_NODE_NAME="${INGRESS_NODE_NAME:-$(default_ingress_node_name)}"
  REPORT_NODE_NAME="${REPORT_NODE_NAME:-}"
  ALLOWLIST_IPV4="${ALLOWLIST_IPV4:-}"
  local allowed_ip
  local -a allowed_ips
  read -r -a allowed_ips <<< "$ALLOWLIST_IPV4"
  for allowed_ip in "${allowed_ips[@]}"; do
    is_ipv4 "$allowed_ip" || { echo "Ошибка: неверный IPv4 в ALLOWLIST_IPV4" >&2; return 1; }
  done

  validate_timeout "$BAN_TIMEOUT" || return 1

  validate_pagination "$PAGE_SIZE" "$MAX_PAGES" || return 1

}

require_api_config() {
  validate_api_config "${REMNAWAVE_API_BASE:-}" "${REMNAWAVE_API_TOKEN:-}"
}

init_last_id() {
  LAST_ID=0
  if [[ -f "$LAST_ID_FILE" ]]; then
    LAST_ID="$(cat "$LAST_ID_FILE")"
    if ! [[ "$LAST_ID" =~ ^(0|[1-9][0-9]{0,15})$ ]] || (( LAST_ID > 9007199254740991 )); then
      echo "Ошибка: повреждён last_id; автоматический сброс запрещён." >&2
      return 1
    fi
  else
    save_last_id 0
  fi
}

ensure_nft() {
  nft list table inet "$TABLE" >/dev/null 2>&1 || nft add table inet "$TABLE" || return 1
  nft list set inet "$TABLE" "$SET" >/dev/null 2>&1 ||
    nft add set inet "$TABLE" "$SET" '{ type ipv4_addr; flags timeout; }' || return 1
  nft list chain inet "$TABLE" "$CHAIN" >/dev/null 2>&1 ||
    nft add chain inet "$TABLE" "$CHAIN" '{ type filter hook input priority -110; policy accept; }' || return 1
  local rules
  rules="$(nft list chain inet "$TABLE" "$CHAIN")" || return 1
  if ! grep -q "ip saddr @${SET} drop" <<< "$rules"; then
    nft add rule inet "$TABLE" "$CHAIN" ip saddr "@${SET}" drop || return 1
  fi
}

load_bans() {
  local bans
  mkdir -p "$STATE_DIR" || return 1
  chmod 700 "$STATE_DIR" || return 1
  bans='{}'
  if [[ -f "$BANS_FILE" ]]; then
    bans="$(cat "$BANS_FILE")" || return 1
  elif nft list set inet "$TABLE" "$SET" >/dev/null 2>&1; then
    # First upgrade: retain the remaining lifetime of existing timed bans.
    local existing now
    existing="$(nft -j list set inet "$TABLE" "$SET")" || return 1
    now="$(date +%s)"
    bans="$(jq --argjson now "$now" '
      [.nftables[] | .set? | select(. != null) | .elem[]? | .elem
       | select(.expires? > 0) | {key: .val, value: ($now + (.expires | floor))}]
      | from_entries' <<< "$existing")" || return 1
  fi
  if ! jq -e 'type == "object" and all(to_entries[];
      (.key | test("^([0-9]{1,3}\\.){3}[0-9]{1,3}$")) and
      (.value | type == "number" and . > 0 and . <= 9007199254740991 and floor == .))' \
      <<< "$bans" >/dev/null; then
    echo "Ошибка: повреждён журнал блокировок $BANS_FILE" >&2
    return 1
  fi
  local keys ip
  keys="$(jq -r 'keys[]' <<< "$bans")" || return 1
  while IFS= read -r ip; do
    [[ -z "$ip" ]] && continue
    is_ipv4 "$ip" || return 1
  done <<< "$keys"
  printf '%s\n' "$bans"
}

save_bans() {
  local tmp bans="$1"
  tmp="$(mktemp "${STATE_DIR}/bans.XXXXXX")" || return 1
  if ! printf '%s\n' "$bans" > "$tmp" || ! mv "$tmp" "$BANS_FILE"; then
    rm -f "$tmp"
    return 1
  fi
}

apply_ban_until() {
  local ip="$1" expiry="$2" now remaining transaction=""
  now="$(date +%s)"
  remaining=$((expiry - now))
  (( remaining > 0 )) || return 0
  if nft get element inet "$TABLE" "$SET" "{ $ip }" >/dev/null 2>&1; then
    transaction="delete element inet $TABLE $SET { $ip }"$'\n'
  fi
  transaction+="add element inet $TABLE $SET { $ip timeout ${remaining}s }"
  # One nft batch is atomic: an add failure cannot remove the existing ban.
  printf '%s\n' "$transaction" | nft -f -
}

restore_bans() (
  exec 8>"$FIREWALL_LOCK" || exit 1
  flock -x 8 || exit 1
  local restored_bans
  restored_bans="$(load_bans)" || exit 1
  local now entries ip expiry
  now="$(date +%s)"
  restored_bans="$(jq --argjson now "$now" 'with_entries(select(.value > $now))' <<< "$restored_bans")" || exit 1
  save_bans "$restored_bans" || exit 1
  ensure_nft || exit 1
  entries="$(jq -r 'to_entries[] | [.key, .value] | @tsv' <<< "$restored_bans")" || exit 1
  while IFS=$'\t' read -r ip expiry; do
    [[ -z "$ip" ]] && continue
    apply_ban_until "$ip" "$expiry" || exit 1
  done <<< "$entries"
)

is_ipv4() {
  local ip="$1" o o1 o2 o3 o4

  [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1

  IFS='.' read -r o1 o2 o3 o4 <<< "$ip"

  for o in "$o1" "$o2" "$o3" "$o4"; do
    [[ "$o" =~ ^(0|[1-9][0-9]{0,2})$ ]] || return 1
    (( 10#$o >= 0 && 10#$o <= 255 )) || return 1
  done

  return 0
}

safe_value() {
  local value="${1:-}"

  if [[ -z "$value" || "$value" == "null" ]]; then
    echo "-"
  else
    echo "$value"
  fi
}

format_timestamp() {
  local value="${1:-}"

  if [[ -z "$value" || "$value" == "null" || "$value" == "-" ]]; then
    echo "-"
    return 0
  fi

  date -u -d "$value" "+%d.%m.%Y %H:%M:%S UTC" 2>/dev/null || echo "$value"
}

ban_ip() (
  local ip="$1" timeout="$2" now expiry old_expiry seconds
  exec 8>"$FIREWALL_LOCK" || exit 1
  flock -x 8 || exit 1
  local current_bans
  current_bans="$(load_bans)" || exit 1
  now="$(date +%s)"
  seconds="$(timeout_seconds "$timeout")" || exit 1
  expiry=$((now + seconds))
  old_expiry="$(jq -r --arg ip "$ip" '.[$ip] // 0' <<< "$current_bans")" || exit 1
  (( old_expiry <= expiry )) || expiry="$old_expiry"
  current_bans="$(jq --arg ip "$ip" --argjson expiry "$expiry" --argjson now "$now" \
    'with_entries(select(.value > $now)) | .[$ip] = $expiry' <<< "$current_bans")" || exit 1
  # Persist intent before touching the firewall; retries restore it after a failure.
  save_bans "$current_bans" || exit 1
  ensure_nft || exit 1
  apply_ban_until "$ip" "$expiry" || exit 1
  logger -t torrent-blocker "заблокирован ip=$ip до=$expiry" || true
  echo "ОК: IP $ip заблокирован до $(date -u -d "@$expiry" '+%F %T UTC')"
)

fetch_page() {
  fetch_reports "$REMNAWAVE_API_BASE" "$REMNAWAVE_API_TOKEN" "$PAGE_SIZE" "$1"
}

save_last_id() {
  local new_last_id="$1"
  local tmp_file

  if ! [[ "$new_last_id" =~ ^[0-9]+$ ]]; then
    echo "Ошибка: некорректный new_last_id=$new_last_id"
    exit 1
  fi

  tmp_file="$(mktemp "${APP_DIR}/last_id.XXXXXX")" || return 1
  if ! printf '%s\n' "$new_last_id" > "$tmp_file" || ! mv "$tmp_file" "$LAST_ID_FILE"; then
    rm -f "$tmp_file"
    return 1
  fi
}

require_menu_root() {
  if [[ "$(id -u)" -ne 0 ]]; then
    echo "Запусти меню от root"
    exit 1
  fi
}





pause() {
  echo
  read -rp "Нажми Enter..."
}

service_unit_name() {
  local unit

  unit="$(get_env SERVICE_UNIT)"
  echo "${unit:-torrent-blocker.service}"
}

timer_unit_name() {
  local unit

  unit="$(get_env TIMER_UNIT)"
  echo "${unit:-torrent-blocker.timer}"
}

blocker_state() {
  if systemctl is-active --quiet "$(timer_unit_name)"; then
    echo "ВКЛ"
  else
    echo "ВЫКЛ"
  fi
}

ingress_node_name() {
  local node_name

  node_name="$(get_env INGRESS_NODE_NAME)"

  if [[ -z "$node_name" ]]; then
    node_name="$(default_ingress_node_name)"
  fi

  echo "$node_name"
}

display_value() {
  local value="${1:-}"

  if [[ -n "$value" ]]; then
    echo "$value"
  else
    echo "-"
  fi
}

toggle_blocker() {
  local timer_unit

  timer_unit="$(timer_unit_name)"

  if systemctl is-active --quiet "$timer_unit"; then
    systemctl disable --now "$timer_unit"
    echo "ОК: опрос отключён. Действующие баны сохраняются до истечения срока."
  else
    systemctl enable --now "$timer_unit"
    echo "ОК: Torrent Blocker включён"
  fi
}

show_status() {
  echo
  echo "╭────────────────────────────────────╮"
  echo "│ Статус Torrent Blocker             │"
  echo "╰────────────────────────────────────╯"
  echo
  echo "Установка:   $(display_value "$(get_env INSTANCE_NAME)")"
  echo "Сервис:      $(blocker_state)"
  echo "Входная нода: $(display_value "$(ingress_node_name)")"
  echo "Ban timeout: $(get_env BAN_TIMEOUT)"
  echo "Page size:   $(get_env PAGE_SIZE)"
  echo "Max pages:   $(get_env MAX_PAGES)"
  echo
  echo -n "Last ID:     "
  if [[ -f "$LAST_ID_FILE" ]]; then
    cat "$LAST_ID_FILE"
  else
    echo "не найден"
  fi

  echo
  systemctl --no-pager --plain status "$(timer_unit_name)" | sed -n '1,8p' || true
}

run_once() {
  "$APP_SCRIPT"
}

show_logs() {
  journalctl -u "$(service_unit_name)" -n 80 --no-pager
}

show_banned() {
  nft list set inet torrent_guard blocked_ipv4 || true
}

edit_config() {
  nano "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

validate_instance_name() {
  local instance_name="$1"

  [[ "$instance_name" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]]
}

instance_app_dir() {
  local instance_name="$1"

  if [[ "$instance_name" == "default" ]]; then
    echo "/opt/torrent-blocker"
  else
    echo "/opt/torrent-blocker-${instance_name}"
  fi
}

instance_service_unit() {
  local instance_name="$1"

  if [[ "$instance_name" == "default" ]]; then
    echo "torrent-blocker.service"
  else
    echo "torrent-blocker-${instance_name}.service"
  fi
}

instance_timer_unit() {
  local instance_name="$1"

  if [[ "$instance_name" == "default" ]]; then
    echo "torrent-blocker.timer"
  else
    echo "torrent-blocker-${instance_name}.timer"
  fi
}

instance_menu_bin() {
  local instance_name="$1"

  if [[ "$instance_name" == "default" ]]; then
    echo "/usr/local/bin/torrent-blocker"
  else
    echo "/usr/local/bin/torrent-blocker-${instance_name}"
  fi
}

fetch_panel_reports_for_config() {
  fetch_reports "$@"
}

check_panel_api_config() {
  local api_base="$1"
  local api_token="$2"
  local check_error

  echo
  echo "Проверка доступности панели Remnawave..."

  if check_error="$(fetch_panel_reports_for_config "$api_base" "$api_token" 1 0 2>&1 >/dev/null)"; then
    echo "ОК: панель доступна, API-токен работает"
    return 0
  fi

  if [[ -n "$check_error" ]]; then
    echo "$check_error"
  fi

  echo "Проверь URL панели, API-токен и доступ с сервера к панели."
  return 1
}

write_panel_env_file() {
  write_config_file "$1" \
    INSTANCE_NAME "$2" SERVICE_UNIT "$3" TIMER_UNIT "$4" MENU_BIN "$5" \
    REMNAWAVE_API_BASE "${6%/}" REMNAWAVE_API_TOKEN "$7" INGRESS_NODE_NAME "$8" \
    BAN_TIMEOUT "$9" PAGE_SIZE 100 MAX_PAGES 5 REPORT_NODE_NAME "" ALLOWLIST_IPV4 ""
}

write_panel_systemd_units() {
  local service_dst="$1"
  local timer_dst="$2"
  local instance_name="$3"
  local app_dir="$4"
  local service_unit="$5"

  cat > "$service_dst" <<EOF
[Unit]
Description=Torrent Blocker (${instance_name}) - опрос Remnawave reports и локальная блокировка IP
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=${app_dir}
ExecStart=${app_dir}/torrent-blocker --run
EOF

  cat > "$timer_dst" <<EOF
[Unit]
Description=Запуск Torrent Blocker (${instance_name}) каждые 15 секунд

[Timer]
OnBootSec=5
OnUnitActiveSec=15s
AccuracySec=1s
Unit=${service_unit}

[Install]
WantedBy=timers.target
EOF
}

add_panel_instance() {
  local instance_name
  local new_app_dir new_env_file new_service_unit new_timer_unit new_service_dst new_timer_dst new_menu_bin
  local api_base api_token ban_timeout default_ban_timeout ingress_name current_max_id

  echo
  echo "Подключение ещё одной панели"
  echo "Будет создана отдельная установка со своим .env, timer и меню."
  echo "Ban-list nftables общий для всех панелей этого сервера."
  echo

  check_required_commands

  instance_name="$(prompt_input "Как назвать эту панель: ")" || return 1

  if [[ -z "$instance_name" ]]; then
    echo "Ошибка: имя панели не может быть пустым"
    return 1
  fi

  if [[ "$instance_name" == "default" ]]; then
    echo "Ошибка: default уже используется основной установкой"
    return 1
  fi

  if ! validate_instance_name "$instance_name"; then
    echo "Ошибка: имя панели может содержать только A-Z, a-z, 0-9 и дефис"
    return 1
  fi

  new_app_dir="$(instance_app_dir "$instance_name")"
  new_env_file="${new_app_dir}/.env"
  new_service_unit="$(instance_service_unit "$instance_name")"
  new_timer_unit="$(instance_timer_unit "$instance_name")"
  new_service_dst="/etc/systemd/system/${new_service_unit}"
  new_timer_dst="/etc/systemd/system/${new_timer_unit}"
  new_menu_bin="$(instance_menu_bin "$instance_name")"

  if [[ -e "$new_app_dir" || -e "$new_service_dst" || -e "$new_timer_dst" || -e "$new_menu_bin" ]]; then
    echo "Ошибка: установка с таким именем уже существует"
    echo "Каталог: ${new_app_dir}"
    echo "Timer:   ${new_timer_unit}"
    echo "Меню:    ${new_menu_bin}"
    return 1
  fi

  api_base="$(prompt_input "Remnawave API URL, пример https://admin.example.com: ")" || return 1

  if [[ -z "$api_base" ]]; then
    echo "Ошибка: Remnawave API URL не может быть пустым"
    return 1
  fi

  api_base="${api_base%/}"

  api_token="$(prompt_input "Remnawave API token (ввод скрыт): " true)" || return 1

  if [[ -z "$api_token" ]]; then
    echo "Ошибка: Remnawave API token не может быть пустым"
    return 1
  fi

  if ! check_panel_api_config "$api_base" "$api_token"; then
    echo "Новая установка не создана."
    return 1
  fi

  default_ban_timeout="$(get_env BAN_TIMEOUT)"
  default_ban_timeout="${default_ban_timeout:-1h}"
  ban_timeout="$(prompt_input "Время блокировки [${default_ban_timeout}]: ")" || return 1
  ban_timeout="${ban_timeout:-$default_ban_timeout}"

  validate_timeout "$ban_timeout" || return 1

  ingress_name="$(default_ingress_node_name)"

  echo "Получение текущего последнего report id..."

  if ! current_max_id="$(fetch_panel_reports_for_config "$api_base" "$api_token" 100 0 | jq -r '[.response.records[]?.id // 0] | max // 0')"; then
    echo "Ошибка: не удалось получить reports из Remnawave API"
    echo "Новая установка не создана."
    return 1
  fi

  echo
  echo "Создание установки ${instance_name}..."

  mkdir -p "$new_app_dir"
  chmod 700 "$new_app_dir"

  install -m 700 "$APP_SCRIPT" "${new_app_dir}/torrent-blocker"
  install -m 600 "${SCRIPT_DIR}/common.sh" "${new_app_dir}/common.sh"
  write_panel_env_file "$new_env_file" "$instance_name" "$new_service_unit" "$new_timer_unit" "$new_menu_bin" "$api_base" "$api_token" "$ingress_name" "$ban_timeout"

  echo "$current_max_id" > "${new_app_dir}/last_id"
  chmod 600 "${new_app_dir}/last_id"

  restore_bans
  write_panel_systemd_units "$new_service_dst" "$new_timer_dst" "$instance_name" "$new_app_dir" "$new_service_unit"

  mkdir -p "$(dirname "$new_menu_bin")"
  cat > "$new_menu_bin" <<EOF
#!/usr/bin/env bash
exec "${new_app_dir}/torrent-blocker" --menu "\$@"
EOF
  chmod 755 "$new_menu_bin"
  rm -f "/usr/local/bin/torrent-blocker-${instance_name}-menu"

  systemctl daemon-reload
  systemctl enable --now "$new_timer_unit"
  systemctl restart "$new_timer_unit"

  echo
  echo "Готово. Панель подключена."
  echo "Каталог: ${new_app_dir}"
  echo "Меню:    ${new_menu_bin##*/}"
  echo "Timer:   ${new_timer_unit}"
}

settings_menu() {
  while true; do
    clear
    echo "╭────────────────────────────────────╮"
    echo "│ Настройки Torrent Blocker          │"
    echo "╰────────────────────────────────────╯"
    echo
    echo "1) Проверить сейчас"
    echo "2) Статус"
    echo "3) Заблокированные IP"
    echo "4) Логи"
    echo "5) Конфиг"
    echo "6) Подключить ещё одну панель"
    echo "0) Назад"
    echo
    read -rp "Выбор: " CHOICE

    case "$CHOICE" in
      1) run_once; pause ;;
      2) show_status; pause ;;
      3) show_banned; pause ;;
      4) show_logs; pause ;;
      5) edit_config; pause ;;
      6) bash "$APP_SCRIPT" --add-panel || echo "Подключение панели завершилось ошибкой"; pause ;;
      0) return ;;
      *) echo "Неверный пункт"; pause ;;
    esac
  done
}

main_menu() {
  while true; do
    clear
    echo "╭────────────────────────────────────╮"
    echo "│        Torrent Blocker             │"
    echo "╰────────────────────────────────────╯"
    echo
    echo "Установка: $(display_value "$(get_env INSTANCE_NAME)")"
    echo "Сервис:   $(blocker_state)"
    echo
    echo "1) Включить / отключить"
    echo "2) Настройки"
    echo "0) Выход"
    echo
    read -rp "Выбор: " CHOICE

    case "$CHOICE" in
      1) toggle_blocker; pause ;;
      2) settings_menu ;;
      0) exit 0 ;;
      *) echo "Неверный пункт"; pause ;;
    esac
  done
}

run_menu() {
  require_menu_root
  ensure_app_dir
  main_menu
}

process_report_record() {
  local RECORD="$1"
  local ID BLOCKED ACTION_IP SOURCE PROTOCOL OUTBOUND_TAG
  local USER_ID USERNAME USER_UUID NODE_NAME NODE_COUNTRY CREATED_AT CREATED_AT_FORMATTED
  local CLIENT_IP

  ID="$(echo "$RECORD" | jq -r '.id // .reportId // .report.id // 0')" || return 1

  BLOCKED="$(echo "$RECORD" | jq -r '.report.actionReport.blocked // .report.actionReport.isBlocked // false')" || return 1
  ACTION_IP="$(echo "$RECORD" | jq -r '.report.actionReport.ip // .report.actionReport.clientIp // .report.actionReport.client_ip // empty')" || return 1
  SOURCE="$(echo "$RECORD" | jq -r '.report.xrayReport.source // .report.xrayReport.sourceIp // empty')" || return 1
  PROTOCOL="$(echo "$RECORD" | jq -r '.report.xrayReport.protocol // empty')" || return 1
  OUTBOUND_TAG="$(echo "$RECORD" | jq -r '.report.xrayReport.outboundTag // .report.xrayReport.outbound // empty')" || return 1

  USER_ID="$(echo "$RECORD" | jq -r '.userId // .report.actionReport.userId // .user.id // empty')" || return 1
  USERNAME="$(echo "$RECORD" | jq -r '.user.username // .username // empty')" || return 1
  USER_UUID="$(echo "$RECORD" | jq -r '.user.uuid // .user.vlessUuid // .userUuid // empty')" || return 1
  NODE_NAME="$(echo "$RECORD" | jq -r '.node.name // .nodeName // empty')" || return 1
  NODE_COUNTRY="$(echo "$RECORD" | jq -r '.node.countryCode // .node.country // empty')" || return 1
  CREATED_AT="$(echo "$RECORD" | jq -r '.createdAt // .timestamp // .report.createdAt // empty')" || return 1

  if [[ -n "${REPORT_NODE_NAME:-}" && "$NODE_NAME" != "$REPORT_NODE_NAME" ]]; then
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    return 0
  fi

  CLIENT_IP="$ACTION_IP"

  if [[ -z "$CLIENT_IP" || "$CLIENT_IP" == "null" ]]; then
    CLIENT_IP="${SOURCE%%:*}"
  fi

  if [[ "$BLOCKED" != "true" && "$PROTOCOL" != "bittorrent" && "$OUTBOUND_TAG" != "RW_TB_OUTBOUND_BLOCK" ]]; then
    echo "Пропуск report id=$ID: это не torrent-нарушение"
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    return 0
  fi

  if ! is_ipv4 "$CLIENT_IP"; then
    echo "Пропуск report id=$ID: некорректный IP=$CLIENT_IP"
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    return 0
  fi

  local allowed_ip
  local -a allowed_ips
  read -r -a allowed_ips <<< "${ALLOWLIST_IPV4:-}"
  for allowed_ip in "${allowed_ips[@]}"; do
    if [[ "$CLIENT_IP" == "$allowed_ip" ]]; then
      echo "Пропуск report id=$ID: IP в ALLOWLIST_IPV4"
      SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
      return 0
    fi
  done

  USER_ID="$(safe_value "$USER_ID")"
  USERNAME="$(safe_value "$USERNAME")"
  USER_UUID="$(safe_value "$USER_UUID")"
  NODE_NAME="$(safe_value "$NODE_NAME")"
  NODE_COUNTRY="$(safe_value "$NODE_COUNTRY")"
  PROTOCOL="$(safe_value "$PROTOCOL")"
  OUTBOUND_TAG="$(safe_value "$OUTBOUND_TAG")"
  CREATED_AT="$(safe_value "$CREATED_AT")"
  CREATED_AT_FORMATTED="$(format_timestamp "$CREATED_AT")"

  echo "Найден torrent-report:"
  echo "  Входная нода:    $INGRESS_NODE_NAME"
  echo "  ID report:       $ID"
  echo "  ID пользователя: $USER_ID"
  echo "  Логин:           $USERNAME"
  echo "  UUID:            $USER_UUID"
  echo "  IP клиента:      $CLIENT_IP"
  echo "  Нода:            $NODE_NAME"
  echo "  Страна ноды:     $NODE_COUNTRY"
  echo "  Протокол:        $PROTOCOL"
  echo "  Outbound:        $OUTBOUND_TAG"
  echo "  Создан:          $CREATED_AT_FORMATTED"

  ban_ip "$CLIENT_IP" "$BAN_TIMEOUT" || return 1

  logger -t torrent-blocker \
    "ingress_node=$INGRESS_NODE_NAME report_id=$ID user_id=$USER_ID username=$USERNAME uuid=$USER_UUID ip=$CLIENT_IP node=$NODE_NAME действие=заблокирован" || true

  PROCESSED_COUNT=$((PROCESSED_COUNT + 1))
}

run_blocker_once() {
  check_required_commands
  ensure_app_dir
  acquire_lock
  load_runtime_config || return 1
  require_api_config || return 1
  init_last_id || return 1
  restore_bans || return 1

  local page start data records count min_id previous_min=""
  local collected='[]' complete=false record id ordered
  PROCESSED_COUNT=0
  SKIPPED_COUNT=0

  # Collect and validate the complete unseen window before applying any report.
  # The endpoint must return newest IDs first; reject unexpected ordering.
  for ((page=0; page<MAX_PAGES; page++)); do
    start=$((page * PAGE_SIZE))
    data="$(fetch_page "$start")" || return 1
    if ! validate_reports <(printf '%s' "$data"); then
      echo "Ошибка: неверная структура reports; last_id не изменён." >&2
      return 1
    fi
    records="$(jq -c '.response.records | map(.id |= tonumber)' <<< "$data")" || return 1
    count="$(jq 'length' <<< "$records")" || return 1
    if (( count == 0 )); then
      complete=true
      break
    fi
    min_id="$(jq 'map(.id) | min' <<< "$records")" || return 1
    if [[ -n "$previous_min" ]] && (( min_id >= previous_min && min_id > LAST_ID )); then
      echo "Ошибка: страницы API не продвигаются; last_id не изменён." >&2
      return 1
    fi
    previous_min="$min_id"
    collected="$(printf '%s\n' "$collected" "$records" | jq -cs 'add | unique_by(.id)')" || return 1
    if (( min_id <= LAST_ID || count < PAGE_SIZE )); then
      complete=true
      break
    fi
  done
  if [[ "$complete" != true ]]; then
    echo "Ошибка: превышено окно PAGE_SIZE × MAX_PAGES. Увеличьте лимит; last_id не изменён, новые reports не применены." >&2
    return 1
  fi
  ordered="$(jq -c --argjson last "$LAST_ID" 'sort_by(.id)[] | select(.id > $last)' <<< "$collected")" || return 1
  while IFS= read -r record; do
    [[ -z "$record" ]] && continue
    process_report_record "$record" || return 1
    id="$(jq -r '.id' <<< "$record")" || return 1
    save_last_id "$id" || return 1
  done <<< "$ordered"
  echo "Готово. Обработано новых reports: $PROCESSED_COUNT. Пропущено: $SKIPPED_COUNT."
}

main() {
  local command_name

  command_name="$(basename "$0")"

  case "${1:-}" in
    --restore)
      check_required_commands
      restore_bans
      ;;
    --add-panel)
      require_menu_root
      add_panel_instance
      ;;
    menu|--menu)
      run_menu
      ;;
    run|once|--run|"")
      if [[ "$command_name" == "torrent-blocker-menu" || "$command_name" =~ ^torrent-blocker-.+-menu$ ]]; then
        run_menu
      else
        run_blocker_once
      fi
      ;;
    *)
      echo "Использование: $command_name [--menu|menu|run]"
      exit 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
