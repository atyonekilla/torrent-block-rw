#!/usr/bin/env bash
set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]:-$0}"
SCRIPT_PATH="$(readlink -f "$SCRIPT_SOURCE" 2>/dev/null || echo "$SCRIPT_SOURCE")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" >/dev/null 2>&1 && pwd || pwd)"

APP_DIR="${TORRENT_BLOCKER_APP_DIR:-$SCRIPT_DIR}"
ENV_FILE="${APP_DIR}/.env"
APP_SCRIPT="${APP_DIR}/torrent-blocker"
LAST_ID_FILE="${APP_DIR}/last_id"
LOCK_FILE="${APP_DIR}/torrent-blocker.lock"

TABLE="torrent_guard"
SET="blocked_ipv4"
CHAIN="input"

REQUIRED_COMMANDS=("curl" "jq" "nft" "logger" "flock")

check_required_commands() {
  local cmd

  for cmd in "${REQUIRED_COMMANDS[@]}"; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo "Ошибка: не найдена команда: $cmd"
      echo "Установи зависимости: apt install -y curl jq nftables util-linux"
      exit 1
    fi
  done
}

ensure_app_dir() {
  if [[ ! -d "$APP_DIR" ]]; then
    echo "Ошибка: не найдена директория: $APP_DIR"
    exit 1
  fi
}

default_ingress_node_name() {
  local host_name ip_address

  host_name="$(hostname 2>/dev/null || echo "unknown-host")"
  read -r ip_address _ < <(hostname -I 2>/dev/null || true)

  if [[ -n "${ip_address:-}" ]]; then
    echo "${host_name} (${ip_address})"
  else
    echo "$host_name"
  fi
}

acquire_lock() {
  exec 9>"$LOCK_FILE"

  if ! flock -n 9; then
    echo "Torrent Blocker уже запущен, текущий запуск пропущен"
    exit 0
  fi
}

load_runtime_config() {
  if [[ ! -f "$ENV_FILE" ]]; then
    echo "Ошибка: не найден файл конфигурации: $ENV_FILE"
    exit 1
  fi

  set -a
  source "$ENV_FILE"
  set +a

  INSTANCE_NAME="${INSTANCE_NAME:-default}"
  SERVICE_UNIT="${SERVICE_UNIT:-torrent-blocker.service}"
  TIMER_UNIT="${TIMER_UNIT:-torrent-blocker.timer}"
  MENU_BIN="${MENU_BIN:-/usr/local/bin/torrent-blocker}"

  BAN_TIMEOUT="${BAN_TIMEOUT:-1h}"
  PAGE_SIZE="${PAGE_SIZE:-100}"
  MAX_PAGES="${MAX_PAGES:-5}"
  INGRESS_NODE_NAME="${INGRESS_NODE_NAME:-$(default_ingress_node_name)}"

  if ! [[ "$BAN_TIMEOUT" =~ ^[0-9]+[smhd]$ ]]; then
    echo "Ошибка: BAN_TIMEOUT должен быть в формате 30s, 30m, 1h или 1d"
    exit 1
  fi

  if ! [[ "$PAGE_SIZE" =~ ^[0-9]+$ ]] || (( PAGE_SIZE < 1 || PAGE_SIZE > 500 )); then
    echo "Ошибка: PAGE_SIZE должен быть числом от 1 до 500"
    exit 1
  fi

  if ! [[ "$MAX_PAGES" =~ ^[0-9]+$ ]] || (( MAX_PAGES < 1 || MAX_PAGES > 50 )); then
    echo "Ошибка: MAX_PAGES должен быть числом от 1 до 50"
    exit 1
  fi

}

require_api_config() {
  if [[ -z "${REMNAWAVE_API_BASE:-}" ]]; then
    echo "Ошибка: REMNAWAVE_API_BASE не задан"
    exit 1
  fi

  if [[ -z "${REMNAWAVE_API_TOKEN:-}" ]]; then
    echo "Ошибка: REMNAWAVE_API_TOKEN не задан"
    exit 1
  fi
}

init_last_id() {
  LAST_ID="0"

  if [[ -f "$LAST_ID_FILE" ]]; then
    LAST_ID="$(cat "$LAST_ID_FILE" | tr -dc '0-9')"
    LAST_ID="${LAST_ID:-0}"
  else
    echo "0" > "$LAST_ID_FILE"
    chmod 600 "$LAST_ID_FILE"
  fi
}

ensure_nft() {
  nft add table inet "$TABLE" 2>/dev/null || true

  nft add set inet "$TABLE" "$SET" '{ type ipv4_addr; flags timeout; }' 2>/dev/null || true

  nft add chain inet "$TABLE" "$CHAIN" '{ type filter hook input priority -110; policy accept; }' 2>/dev/null || true

  if ! nft list chain inet "$TABLE" "$CHAIN" 2>/dev/null | grep -q "ip saddr @${SET} drop"; then
    nft add rule inet "$TABLE" "$CHAIN" ip saddr "@${SET}" drop
  fi
}

is_ipv4() {
  local ip="$1"

  [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1

  IFS='.' read -r o1 o2 o3 o4 <<< "$ip"

  for o in "$o1" "$o2" "$o3" "$o4"; do
    [[ "$o" =~ ^[0-9]+$ ]] || return 1
    (( o >= 0 && o <= 255 )) || return 1
  done

  return 0
}

safe_value() {
  local value="${1:-}"

  if [[ -z "$value" || "$value" == "null" ]]; then
    echo "-"
  else
    echo "$value"
  fi
}

format_timestamp() {
  local value="${1:-}"

  if [[ -z "$value" || "$value" == "null" || "$value" == "-" ]]; then
    echo "-"
    return 0
  fi

  date -u -d "$value" "+%d.%m.%Y %H:%M:%S UTC" 2>/dev/null || echo "$value"
}

ban_ip() {
  local ip="$1"
  local timeout="$2"

  ensure_nft

  nft delete element inet "$TABLE" "$SET" "{ $ip }" 2>/dev/null || true
  nft add element inet "$TABLE" "$SET" "{ $ip timeout $timeout }"

  logger -t torrent-blocker "заблокирован ip=$ip время_блокировки=$timeout"
  echo "ОК: IP $ip заблокирован на $timeout"
}

fetch_page() {
  local start="$1"
  local body_file http_code url

  url="${REMNAWAVE_API_BASE%/}/api/node-plugins/torrent-blocker?size=${PAGE_SIZE}&start=${start}"
  body_file="$(mktemp)"

  if ! http_code="$(curl -sS \
    --connect-timeout 10 \
    --max-time 30 \
    --retry 2 \
    --retry-delay 1 \
    -H "Authorization: Bearer ${REMNAWAVE_API_TOKEN}" \
    -H "Accept: application/json" \
    -o "$body_file" \
    -w "%{http_code}" \
    "$url")"; then

    rm -f "$body_file"
    echo "Ошибка: не удалось подключиться к Remnawave API" >&2
    echo "URL: $url" >&2
    return 1
  fi

  if [[ ! "$http_code" =~ ^2 ]]; then
    echo "Ошибка: Remnawave API вернул HTTP $http_code" >&2
    echo "URL: $url" >&2
    echo "Ответ:" >&2
    head -c 800 "$body_file" >&2
    echo >&2
    rm -f "$body_file"
    return 1
  fi

  if ! jq -e . "$body_file" >/dev/null 2>&1; then
    echo "Ошибка: Remnawave API вернул не JSON" >&2
    echo "URL: $url" >&2
    echo "Ответ:" >&2
    head -c 800 "$body_file" >&2
    echo >&2
    rm -f "$body_file"
    return 1
  fi

  cat "$body_file"
  rm -f "$body_file"
}

save_last_id() {
  local new_last_id="$1"
  local tmp_file

  if ! [[ "$new_last_id" =~ ^[0-9]+$ ]]; then
    echo "Ошибка: некорректный new_last_id=$new_last_id"
    exit 1
  fi

  tmp_file="$(mktemp "${APP_DIR}/last_id.XXXXXX")"
  echo "$new_last_id" > "$tmp_file"
  chmod 600 "$tmp_file"
  mv "$tmp_file" "$LAST_ID_FILE"
}

require_menu_root() {
  if [[ "$(id -u)" -ne 0 ]]; then
    echo "Запусти меню от root"
    exit 1
  fi
}

escape_env_value() {
  local value="${1:-}"

  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"

  echo "$value"
}

get_env() {
  local key="$1"

  if [[ -f "$ENV_FILE" ]]; then
    grep "^${key}=" "$ENV_FILE" | head -n1 | cut -d= -f2- | sed 's/^"//; s/"$//' || true
  fi
}

pause() {
  echo
  read -rp "Нажми Enter..."
}

service_unit_name() {
  local unit

  unit="$(get_env SERVICE_UNIT)"
  echo "${unit:-torrent-blocker.service}"
}

timer_unit_name() {
  local unit

  unit="$(get_env TIMER_UNIT)"
  echo "${unit:-torrent-blocker.timer}"
}

blocker_state() {
  if systemctl is-active --quiet "$(timer_unit_name)"; then
    echo "ВКЛ"
  else
    echo "ВЫКЛ"
  fi
}

ingress_node_name() {
  local node_name

  node_name="$(get_env INGRESS_NODE_NAME)"

  if [[ -z "$node_name" ]]; then
    node_name="$(default_ingress_node_name)"
  fi

  echo "$node_name"
}

display_value() {
  local value="${1:-}"

  if [[ -n "$value" ]]; then
    echo "$value"
  else
    echo "-"
  fi
}

toggle_blocker() {
  local timer_unit

  timer_unit="$(timer_unit_name)"

  if systemctl is-active --quiet "$timer_unit"; then
    systemctl disable --now "$timer_unit"
    echo "ОК: Torrent Blocker отключён"
  else
    systemctl enable --now "$timer_unit"
    echo "ОК: Torrent Blocker включён"
  fi
}

show_status() {
  echo
  echo "╭────────────────────────────────────╮"
  echo "│ Статус Torrent Blocker             │"
  echo "╰────────────────────────────────────╯"
  echo
  echo "Установка:   $(display_value "$(get_env INSTANCE_NAME)")"
  echo "Сервис:      $(blocker_state)"
  echo "Входная нода: $(display_value "$(ingress_node_name)")"
  echo "Ban timeout: $(get_env BAN_TIMEOUT)"
  echo "Page size:   $(get_env PAGE_SIZE)"
  echo "Max pages:   $(get_env MAX_PAGES)"
  echo
  echo -n "Last ID:     "
  if [[ -f "$LAST_ID_FILE" ]]; then
    cat "$LAST_ID_FILE"
  else
    echo "не найден"
  fi

  echo
  systemctl --no-pager --plain status "$(timer_unit_name)" | sed -n '1,8p' || true
}

run_once() {
  "$APP_SCRIPT"
}

show_logs() {
  journalctl -u "$(service_unit_name)" -n 80 --no-pager
}

show_banned() {
  nft list set inet torrent_guard blocked_ipv4 || true
}

edit_config() {
  nano "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

validate_instance_name() {
  local instance_name="$1"

  [[ "$instance_name" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]]
}

instance_app_dir() {
  local instance_name="$1"

  if [[ "$instance_name" == "default" ]]; then
    echo "/opt/torrent-blocker"
  else
    echo "/opt/torrent-blocker-${instance_name}"
  fi
}

instance_service_unit() {
  local instance_name="$1"

  if [[ "$instance_name" == "default" ]]; then
    echo "torrent-blocker.service"
  else
    echo "torrent-blocker-${instance_name}.service"
  fi
}

instance_timer_unit() {
  local instance_name="$1"

  if [[ "$instance_name" == "default" ]]; then
    echo "torrent-blocker.timer"
  else
    echo "torrent-blocker-${instance_name}.timer"
  fi
}

instance_menu_bin() {
  local instance_name="$1"

  if [[ "$instance_name" == "default" ]]; then
    echo "/usr/local/bin/torrent-blocker"
  else
    echo "/usr/local/bin/torrent-blocker-${instance_name}"
  fi
}

fetch_panel_reports_for_config() {
  local api_base="$1"
  local api_token="$2"
  local size="$3"
  local start="$4"
  local body_file http_code url

  url="${api_base%/}/api/node-plugins/torrent-blocker?size=${size}&start=${start}"
  body_file="$(mktemp)"

  if ! http_code="$(curl -sS \
    --connect-timeout 10 \
    --max-time 30 \
    --retry 2 \
    --retry-delay 1 \
    -H "Authorization: Bearer ${api_token}" \
    -H "Accept: application/json" \
    -o "$body_file" \
    -w "%{http_code}" \
    "$url")"; then

    rm -f "$body_file"
    echo "Ошибка: не удалось подключиться к Remnawave API" >&2
    echo "URL: $url" >&2
    return 1
  fi

  if [[ ! "$http_code" =~ ^2 ]]; then
    echo "Ошибка: Remnawave API вернул HTTP $http_code" >&2
    echo "URL: $url" >&2
    echo "Ответ:" >&2
    head -c 800 "$body_file" >&2
    echo >&2
    rm -f "$body_file"
    return 1
  fi

  if ! jq -e . "$body_file" >/dev/null 2>&1; then
    echo "Ошибка: Remnawave API вернул не JSON" >&2
    echo "URL: $url" >&2
    echo "Ответ:" >&2
    head -c 800 "$body_file" >&2
    echo >&2
    rm -f "$body_file"
    return 1
  fi

  cat "$body_file"
  rm -f "$body_file"
}

check_panel_api_config() {
  local api_base="$1"
  local api_token="$2"
  local check_error

  echo
  echo "Проверка доступности панели Remnawave..."

  if check_error="$(fetch_panel_reports_for_config "$api_base" "$api_token" 1 0 2>&1 >/dev/null)"; then
    echo "ОК: панель доступна, API-токен работает"
    return 0
  fi

  if [[ -n "$check_error" ]]; then
    echo "$check_error"
  fi

  echo "Проверь URL панели, API-токен и доступ с сервера к панели."
  return 1
}

write_panel_env_file() {
  local target_env_file="$1"
  local instance_name="$2"
  local service_unit="$3"
  local timer_unit="$4"
  local menu_bin="$5"
  local api_base="$6"
  local api_token="$7"
  local ingress_node_name="$8"
  local ban_timeout="$9"

  cat > "$target_env_file" <<EOF
INSTANCE_NAME="$(escape_env_value "$instance_name")"
SERVICE_UNIT="$(escape_env_value "$service_unit")"
TIMER_UNIT="$(escape_env_value "$timer_unit")"
MENU_BIN="$(escape_env_value "$menu_bin")"

REMNAWAVE_API_BASE="$(escape_env_value "${api_base%/}")"
REMNAWAVE_API_TOKEN="$(escape_env_value "$api_token")"

INGRESS_NODE_NAME="$(escape_env_value "$ingress_node_name")"

BAN_TIMEOUT="$(escape_env_value "$ban_timeout")"
PAGE_SIZE="100"
MAX_PAGES="5"
EOF

  chmod 600 "$target_env_file"
}

write_panel_systemd_units() {
  local service_dst="$1"
  local timer_dst="$2"
  local instance_name="$3"
  local app_dir="$4"
  local service_unit="$5"

  cat > "$service_dst" <<EOF
[Unit]
Description=Torrent Blocker (${instance_name}) - опрос Remnawave reports и локальная блокировка IP
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=${app_dir}
ExecStart=${app_dir}/torrent-blocker --run
EOF

  cat > "$timer_dst" <<EOF
[Unit]
Description=Запуск Torrent Blocker (${instance_name}) каждые 15 секунд

[Timer]
OnBootSec=30
OnUnitActiveSec=15s
AccuracySec=1s
Unit=${service_unit}

[Install]
WantedBy=timers.target
EOF
}

add_panel_instance() {
  local instance_name
  local new_app_dir new_env_file new_service_unit new_timer_unit new_service_dst new_timer_dst new_menu_bin
  local api_base api_token ban_timeout default_ban_timeout ingress_name current_max_id

  echo
  echo "Подключение ещё одной панели"
  echo "Будет создана отдельная установка со своим .env, timer и меню."
  echo "Ban-list nftables общий для всех панелей этого сервера."
  echo

  check_required_commands

  read -rp "Как назвать эту панель: " instance_name

  if [[ -z "$instance_name" ]]; then
    echo "Ошибка: имя панели не может быть пустым"
    return 1
  fi

  if [[ "$instance_name" == "default" ]]; then
    echo "Ошибка: default уже используется основной установкой"
    return 1
  fi

  if ! validate_instance_name "$instance_name"; then
    echo "Ошибка: имя панели может содержать только A-Z, a-z, 0-9 и дефис"
    return 1
  fi

  new_app_dir="$(instance_app_dir "$instance_name")"
  new_env_file="${new_app_dir}/.env"
  new_service_unit="$(instance_service_unit "$instance_name")"
  new_timer_unit="$(instance_timer_unit "$instance_name")"
  new_service_dst="/etc/systemd/system/${new_service_unit}"
  new_timer_dst="/etc/systemd/system/${new_timer_unit}"
  new_menu_bin="$(instance_menu_bin "$instance_name")"

  if [[ -e "$new_app_dir" || -e "$new_service_dst" || -e "$new_timer_dst" || -e "$new_menu_bin" ]]; then
    echo "Ошибка: установка с таким именем уже существует"
    echo "Каталог: ${new_app_dir}"
    echo "Timer:   ${new_timer_unit}"
    echo "Меню:    ${new_menu_bin}"
    return 1
  fi

  read -rp "Remnawave API URL, пример https://admin.example.com: " api_base

  if [[ -z "$api_base" ]]; then
    echo "Ошибка: Remnawave API URL не может быть пустым"
    return 1
  fi

  api_base="${api_base%/}"

  read -rp "Remnawave API token: " api_token

  if [[ -z "$api_token" ]]; then
    echo "Ошибка: Remnawave API token не может быть пустым"
    return 1
  fi

  if ! check_panel_api_config "$api_base" "$api_token"; then
    echo "Новая установка не создана."
    return 1
  fi

  default_ban_timeout="$(get_env BAN_TIMEOUT)"
  default_ban_timeout="${default_ban_timeout:-1h}"
  read -rp "Время блокировки [${default_ban_timeout}]: " ban_timeout
  ban_timeout="${ban_timeout:-$default_ban_timeout}"

  if ! [[ "$ban_timeout" =~ ^[0-9]+[smhd]$ ]]; then
    echo "Ошибка: время блокировки должно быть в формате 30s, 30m, 1h или 1d"
    return 1
  fi

  ingress_name="$(default_ingress_node_name)"

  echo "Получение текущего последнего report id..."

  if ! current_max_id="$(fetch_panel_reports_for_config "$api_base" "$api_token" 100 0 | jq -r '[.response.records[]?.id // 0] | max // 0')"; then
    echo "Ошибка: не удалось получить reports из Remnawave API"
    echo "Новая установка не создана."
    return 1
  fi

  echo
  echo "Создание установки ${instance_name}..."

  systemctl enable --now nftables
  mkdir -p "$new_app_dir"
  chmod 700 "$new_app_dir"

  install -m 700 "$APP_SCRIPT" "${new_app_dir}/torrent-blocker"
  write_panel_env_file "$new_env_file" "$instance_name" "$new_service_unit" "$new_timer_unit" "$new_menu_bin" "$api_base" "$api_token" "$ingress_name" "$ban_timeout"

  echo "$current_max_id" > "${new_app_dir}/last_id"
  chmod 600 "${new_app_dir}/last_id"

  ensure_nft
  write_panel_systemd_units "$new_service_dst" "$new_timer_dst" "$instance_name" "$new_app_dir" "$new_service_unit"

  mkdir -p "$(dirname "$new_menu_bin")"
  cat > "$new_menu_bin" <<EOF
#!/usr/bin/env bash
exec "${new_app_dir}/torrent-blocker" --menu "\$@"
EOF
  chmod 755 "$new_menu_bin"
  rm -f "/usr/local/bin/torrent-blocker-${instance_name}-menu"

  systemctl daemon-reload
  systemctl enable --now "$new_timer_unit"
  systemctl restart "$new_timer_unit"

  echo
  echo "Готово. Панель подключена."
  echo "Каталог: ${new_app_dir}"
  echo "Меню:    ${new_menu_bin##*/}"
  echo "Timer:   ${new_timer_unit}"
}

settings_menu() {
  while true; do
    clear
    echo "╭────────────────────────────────────╮"
    echo "│ Настройки Torrent Blocker          │"
    echo "╰────────────────────────────────────╯"
    echo
    echo "1) Проверить сейчас"
    echo "2) Статус"
    echo "3) Заблокированные IP"
    echo "4) Логи"
    echo "5) Конфиг"
    echo "6) Подключить ещё одну панель"
    echo "0) Назад"
    echo
    read -rp "Выбор: " CHOICE

    case "$CHOICE" in
      1) run_once; pause ;;
      2) show_status; pause ;;
      3) show_banned; pause ;;
      4) show_logs; pause ;;
      5) edit_config; pause ;;
      6) add_panel_instance || true; pause ;;
      0) return ;;
      *) echo "Неверный пункт"; pause ;;
    esac
  done
}

main_menu() {
  while true; do
    clear
    echo "╭────────────────────────────────────╮"
    echo "│        Torrent Blocker             │"
    echo "╰────────────────────────────────────╯"
    echo
    echo "Установка: $(display_value "$(get_env INSTANCE_NAME)")"
    echo "Сервис:   $(blocker_state)"
    echo
    echo "1) Включить / отключить"
    echo "2) Настройки"
    echo "0) Выход"
    echo
    read -rp "Выбор: " CHOICE

    case "$CHOICE" in
      1) toggle_blocker; pause ;;
      2) settings_menu ;;
      0) exit 0 ;;
      *) echo "Неверный пункт"; pause ;;
    esac
  done
}

run_menu() {
  require_menu_root
  ensure_app_dir
  main_menu
}

process_report_record() {
  local RECORD="$1"
  local ID BLOCKED ACTION_IP SOURCE PROTOCOL OUTBOUND_TAG
  local USER_ID USERNAME USER_UUID NODE_NAME NODE_COUNTRY CREATED_AT CREATED_AT_FORMATTED
  local CLIENT_IP

  ID="$(echo "$RECORD" | jq -r '.id // .reportId // .report.id // 0')"

  BLOCKED="$(echo "$RECORD" | jq -r '.report.actionReport.blocked // .report.actionReport.isBlocked // false')"
  ACTION_IP="$(echo "$RECORD" | jq -r '.report.actionReport.ip // .report.actionReport.clientIp // .report.actionReport.client_ip // empty')"
  SOURCE="$(echo "$RECORD" | jq -r '.report.xrayReport.source // .report.xrayReport.sourceIp // empty')"
  PROTOCOL="$(echo "$RECORD" | jq -r '.report.xrayReport.protocol // empty')"
  OUTBOUND_TAG="$(echo "$RECORD" | jq -r '.report.xrayReport.outboundTag // .report.xrayReport.outbound // empty')"

  USER_ID="$(echo "$RECORD" | jq -r '.userId // .report.actionReport.userId // .user.id // empty')"
  USERNAME="$(echo "$RECORD" | jq -r '.user.username // .username // empty')"
  USER_UUID="$(echo "$RECORD" | jq -r '.user.uuid // .user.vlessUuid // .userUuid // empty')"
  NODE_NAME="$(echo "$RECORD" | jq -r '.node.name // .nodeName // empty')"
  NODE_COUNTRY="$(echo "$RECORD" | jq -r '.node.countryCode // .node.country // empty')"
  CREATED_AT="$(echo "$RECORD" | jq -r '.createdAt // .timestamp // .report.createdAt // empty')"

  CLIENT_IP="$ACTION_IP"

  if [[ -z "$CLIENT_IP" || "$CLIENT_IP" == "null" ]]; then
    CLIENT_IP="${SOURCE%%:*}"
  fi

  if [[ "$BLOCKED" != "true" && "$PROTOCOL" != "bittorrent" && "$OUTBOUND_TAG" != "RW_TB_OUTBOUND_BLOCK" ]]; then
    echo "Пропуск report id=$ID: это не torrent-нарушение"
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    return 0
  fi

  if ! is_ipv4 "$CLIENT_IP"; then
    echo "Пропуск report id=$ID: некорректный IP=$CLIENT_IP"
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    return 0
  fi

  USER_ID="$(safe_value "$USER_ID")"
  USERNAME="$(safe_value "$USERNAME")"
  USER_UUID="$(safe_value "$USER_UUID")"
  NODE_NAME="$(safe_value "$NODE_NAME")"
  NODE_COUNTRY="$(safe_value "$NODE_COUNTRY")"
  PROTOCOL="$(safe_value "$PROTOCOL")"
  OUTBOUND_TAG="$(safe_value "$OUTBOUND_TAG")"
  CREATED_AT="$(safe_value "$CREATED_AT")"
  CREATED_AT_FORMATTED="$(format_timestamp "$CREATED_AT")"

  echo "Найден torrent-report:"
  echo "  Входная нода:    $INGRESS_NODE_NAME"
  echo "  ID report:       $ID"
  echo "  ID пользователя: $USER_ID"
  echo "  Логин:           $USERNAME"
  echo "  UUID:            $USER_UUID"
  echo "  IP клиента:      $CLIENT_IP"
  echo "  Нода:            $NODE_NAME"
  echo "  Страна ноды:     $NODE_COUNTRY"
  echo "  Протокол:        $PROTOCOL"
  echo "  Outbound:        $OUTBOUND_TAG"
  echo "  Создан:          $CREATED_AT_FORMATTED"

  ban_ip "$CLIENT_IP" "$BAN_TIMEOUT"

  logger -t torrent-blocker \
    "ingress_node=$INGRESS_NODE_NAME report_id=$ID user_id=$USER_ID username=$USERNAME uuid=$USER_UUID ip=$CLIENT_IP node=$NODE_NAME действие=заблокирован"

  PROCESSED_COUNT=$((PROCESSED_COUNT + 1))
}

run_blocker_once() {
  check_required_commands
  ensure_app_dir
  acquire_lock
  load_runtime_config
  require_api_config
  init_last_id
  ensure_nft

GLOBAL_MAX_ID="$LAST_ID"
PROCESSED_COUNT=0
SKIPPED_COUNT=0

for (( PAGE=0; PAGE<MAX_PAGES; PAGE++ )); do
  START=$(( PAGE * PAGE_SIZE ))

  DATA="$(fetch_page "$START")"

  RECORD_COUNT="$(echo "$DATA" | jq -r '(.response.records // []) | length')"

  if [[ "$RECORD_COUNT" == "0" ]]; then
    break
  fi

  PAGE_MAX_ID="$(echo "$DATA" | jq -r '[.response.records[]?.id // 0] | max // 0')"

  if [[ "$PAGE_MAX_ID" =~ ^[0-9]+$ ]] && (( PAGE_MAX_ID > GLOBAL_MAX_ID )); then
    GLOBAL_MAX_ID="$PAGE_MAX_ID"
  fi

  while read -r RECORD; do
    [[ -z "$RECORD" ]] && continue
    process_report_record "$RECORD"

  done < <(
    echo "$DATA" | jq -c --argjson last "$LAST_ID" '
      (.response.records // [])
      | sort_by(.id)
      | .[]
      | select((.id | tonumber) > $last)
    '
  )
done

if [[ "$GLOBAL_MAX_ID" =~ ^[0-9]+$ ]] && (( GLOBAL_MAX_ID > LAST_ID )); then
  save_last_id "$GLOBAL_MAX_ID"
fi

echo "Готово. Обработано новых reports: $PROCESSED_COUNT. Пропущено: $SKIPPED_COUNT. Был last_id=$LAST_ID, стал last_id=$GLOBAL_MAX_ID"
}

main() {
  local command_name

  command_name="$(basename "$0")"

  case "${1:-}" in
    menu|--menu)
      run_menu
      ;;
    run|once|--run|"")
      if [[ "$command_name" == "torrent-blocker-menu" || "$command_name" =~ ^torrent-blocker-.+-menu$ ]]; then
        run_menu
      else
        run_blocker_once
      fi
      ;;
    *)
      echo "Использование: $command_name [--menu|menu|run]"
      exit 1
      ;;
  esac
}

main "$@"
