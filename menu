#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/opt/torrent-blocker"
ENV_FILE="${APP_DIR}/.env"
APP_SCRIPT="${APP_DIR}/torrent-blocker"
LAST_ID_FILE="${APP_DIR}/last_id"

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Запусти меню от root"
  exit 1
fi

set_env() {
  local key="$1"
  local value="$2"
  local tmp

  tmp="$(mktemp)"

  if grep -q "^${key}=" "$ENV_FILE"; then
    awk -v k="$key" -v v="$value" '
      BEGIN { q = sprintf("%c", 34) }
      $0 ~ "^" k "=" { $0 = k "=" q v q }
      { print }
    ' "$ENV_FILE" > "$tmp"
  else
    cat "$ENV_FILE" > "$tmp"
    echo "${key}=\"${value}\"" >> "$tmp"
  fi

  mv "$tmp" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

get_env() {
  local key="$1"

  if [[ -f "$ENV_FILE" ]]; then
    grep "^${key}=" "$ENV_FILE" | head -n1 | cut -d= -f2- | sed 's/^"//; s/"$//' || true
  fi
}

pause() {
  echo
  read -rp "Нажми Enter..."
}

blocker_state() {
  if systemctl is-active --quiet torrent-blocker.timer; then
    echo "ВКЛ"
  else
    echo "ВЫКЛ"
  fi
}

telegram_state() {
  if [[ "$(get_env TELEGRAM_ENABLED)" == "true" ]]; then
    echo "ВКЛ"
  else
    echo "ВЫКЛ"
  fi
}

telegram_chat_id() {
  local chat_id

  chat_id="$(get_env TELEGRAM_CHAT_ID)"

  if [[ -z "$chat_id" ]]; then
    chat_id="$(get_env TELEGRAM_ADMIN_ID)"
  fi

  echo "$chat_id"
}

telegram_topic_id() {
  get_env TELEGRAM_TOPIC_ID
}

default_ingress_node_name() {
  local host_name ip_address

  host_name="$(hostname 2>/dev/null || echo "unknown-host")"
  read -r ip_address _ < <(hostname -I 2>/dev/null || true)

  if [[ -n "${ip_address:-}" ]]; then
    echo "${host_name} (${ip_address})"
  else
    echo "$host_name"
  fi
}

ingress_node_name() {
  local node_name

  node_name="$(get_env INGRESS_NODE_NAME)"

  if [[ -z "$node_name" ]]; then
    node_name="$(default_ingress_node_name)"
  fi

  echo "$node_name"
}

html_escape() {
  local value="${1:-}"

  value="${value//&/&amp;}"
  value="${value//</&lt;}"
  value="${value//>/&gt;}"
  value="${value//\"/&quot;}"

  echo "$value"
}

display_value() {
  local value="${1:-}"

  if [[ -n "$value" ]]; then
    echo "$value"
  else
    echo "-"
  fi
}

toggle_blocker() {
  if systemctl is-active --quiet torrent-blocker.timer; then
    systemctl disable --now torrent-blocker.timer
    echo "ОК: Torrent Blocker отключён"
  else
    systemctl enable --now torrent-blocker.timer
    echo "ОК: Torrent Blocker включён"
  fi
}

show_status() {
  echo
  echo "╭────────────────────────────────────╮"
  echo "│ Статус Torrent Blocker             │"
  echo "╰────────────────────────────────────╯"
  echo
  echo "Сервис:      $(blocker_state)"
  echo "Входная нода: $(display_value "$(ingress_node_name)")"
  echo "Telegram:    $(telegram_state)"
  echo "Chat ID:     $(display_value "$(telegram_chat_id)")"
  echo "Topic ID:    $(display_value "$(telegram_topic_id)")"
  echo "Ban timeout: $(get_env BAN_TIMEOUT)"
  echo "Page size:   $(get_env PAGE_SIZE)"
  echo "Max pages:   $(get_env MAX_PAGES)"
  echo
  echo -n "Last ID:     "
  if [[ -f "$LAST_ID_FILE" ]]; then
    cat "$LAST_ID_FILE"
  else
    echo "не найден"
  fi

  echo
  systemctl --no-pager --plain status torrent-blocker.timer | sed -n '1,8p' || true
}

run_once() {
  "$APP_SCRIPT"
}

show_logs() {
  journalctl -u torrent-blocker.service -n 80 --no-pager
}

show_banned() {
  nft list set inet torrent_guard blocked_ipv4 || true
}

edit_config() {
  nano "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

telegram_setup() {
  local CURRENT_BOT_TOKEN CURRENT_CHAT_ID CURRENT_TOPIC_ID
  local BOT_TOKEN CHAT_ID TOPIC_ID

  echo
  echo "Настройка Telegram"
  echo
  echo "Для группы или топика добавь бота в чат и отправь сообщение в нужный топик."
  echo "Затем укажи chat id группы и topic id/message_thread_id топика."
  echo

  CURRENT_BOT_TOKEN="$(get_env TELEGRAM_BOT_TOKEN)"
  CURRENT_CHAT_ID="$(telegram_chat_id)"
  CURRENT_TOPIC_ID="$(telegram_topic_id)"

  read -rp "Telegram Bot Token${CURRENT_BOT_TOKEN:+ [оставить текущий]}: " BOT_TOKEN
  BOT_TOKEN="${BOT_TOKEN:-$CURRENT_BOT_TOKEN}"

  read -rp "Telegram Chat ID${CURRENT_CHAT_ID:+ [$CURRENT_CHAT_ID]}: " CHAT_ID
  CHAT_ID="${CHAT_ID:-$CURRENT_CHAT_ID}"

  read -rp "Telegram Topic ID / message_thread_id${CURRENT_TOPIC_ID:+ [$CURRENT_TOPIC_ID]} (Enter оставить, '-' очистить): " TOPIC_ID

  if [[ "$TOPIC_ID" == "-" ]]; then
    TOPIC_ID=""
  elif [[ -z "$TOPIC_ID" ]]; then
    TOPIC_ID="$CURRENT_TOPIC_ID"
  fi

  if [[ -z "$BOT_TOKEN" || -z "$CHAT_ID" ]]; then
    echo "Ошибка: токен и chat id не должны быть пустыми"
    return 1
  fi

  if [[ -n "$TOPIC_ID" && ! "$TOPIC_ID" =~ ^[0-9]+$ ]]; then
    echo "Ошибка: topic id должен быть числом"
    return 1
  fi

  set_env "TELEGRAM_BOT_TOKEN" "$BOT_TOKEN"
  set_env "TELEGRAM_CHAT_ID" "$CHAT_ID"
  set_env "TELEGRAM_TOPIC_ID" "$TOPIC_ID"
  set_env "TELEGRAM_ENABLED" "true"

  echo
  echo "ОК: Telegram настроен и включён"
}

telegram_toggle() {
  if [[ "$(get_env TELEGRAM_ENABLED)" == "true" ]]; then
    set_env "TELEGRAM_ENABLED" "false"
    echo "ОК: Telegram-уведомления отключены"
  else
    set_env "TELEGRAM_ENABLED" "true"
    echo "ОК: Telegram-уведомления включены"
  fi
}

telegram_test() {
  local -a curl_args
  local TG_INGRESS_NODE_NAME

  set -a
  source "$ENV_FILE"
  set +a

  TELEGRAM_CHAT_ID="${TELEGRAM_CHAT_ID:-${TELEGRAM_ADMIN_ID:-}}"
  TELEGRAM_TOPIC_ID="${TELEGRAM_TOPIC_ID:-}"
  INGRESS_NODE_NAME="${INGRESS_NODE_NAME:-$(default_ingress_node_name)}"

  if [[ "${TELEGRAM_ENABLED:-false}" != "true" ]]; then
    echo "Telegram выключен. Сначала включи его."
    return 1
  fi

  if [[ -z "${TELEGRAM_BOT_TOKEN:-}" || -z "${TELEGRAM_CHAT_ID:-}" ]]; then
    echo "Не задан TELEGRAM_BOT_TOKEN или TELEGRAM_CHAT_ID"
    return 1
  fi

  if [[ -n "$TELEGRAM_TOPIC_ID" && ! "$TELEGRAM_TOPIC_ID" =~ ^[0-9]+$ ]]; then
    echo "TELEGRAM_TOPIC_ID должен быть числом"
    return 1
  fi

  TG_INGRESS_NODE_NAME="$(html_escape "$INGRESS_NODE_NAME")"

  TEST_TEXT="✅ Torrent Blocker: тестовое уведомление

Сообщение отправлено в указанный chat id и topic id, если он задан.

━━━━━━━━━━━━━━━━━━━━
Пример боевого report
━━━━━━━━━━━━━━━━━━━━

<b>🚫 Торрент заблокирован</b>

<b>🖥 Сервер</b>
• Входная нода: <code>${TG_INGRESS_NODE_NAME}</code>

<b>⛔ Блокировка</b>
• IP клиента: <code>46.1.1.1</code>
• Срок: <code>1h</code>

<b>👤 Пользователь</b>
• ID: <code>1701</code>
• Логин: <code>1701</code>
• UUID: <code>123e4567-e89b-12d3-a456-426614174000</code>

<b>📄 Report</b>
• ID: <code>678</code>
• Нода: <code>poland</code>
• Страна: <code>PL</code>
• Создан: <code>09.05.2026 02:27:47 UTC</code>"

  curl_args=(
    -fsS
    --connect-timeout 10
    --max-time 15
    -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage"
    -d "chat_id=${TELEGRAM_CHAT_ID}"
    --data-urlencode "text=${TEST_TEXT}"
    -d "parse_mode=HTML"
    -d "disable_web_page_preview=true"
  )

  if [[ -n "$TELEGRAM_TOPIC_ID" ]]; then
    curl_args+=(-d "message_thread_id=${TELEGRAM_TOPIC_ID}")
  fi

  curl "${curl_args[@]}" >/dev/null

  echo "ОК: тестовое уведомление с примером report отправлено"
}

telegram_menu() {
  while true; do
    clear
    echo "╭────────────────────────────────────╮"
    echo "│ Telegram уведомления               │"
    echo "╰────────────────────────────────────╯"
    echo
    echo "Статус:   $(telegram_state)"
    echo "Chat ID:  $(display_value "$(telegram_chat_id)")"
    echo "Topic ID: $(display_value "$(telegram_topic_id)")"
    echo
    echo "1) Настроить Telegram"
    echo "2) Включить / отключить"
    echo "3) Отправить тест"
    echo "0) Назад"
    echo
    read -rp "Выбор: " CHOICE

    case "$CHOICE" in
      1) telegram_setup; pause ;;
      2) telegram_toggle; pause ;;
      3) telegram_test; pause ;;
      0) return ;;
      *) echo "Неверный пункт"; pause ;;
    esac
  done
}

main_menu() {
  while true; do
    clear
    echo "╭────────────────────────────────────╮"
    echo "│        Torrent Blocker             │"
    echo "╰────────────────────────────────────╯"
    echo
    echo "Сервис:   $(blocker_state)"
    echo "Telegram: $(telegram_state)"
    echo
    echo "1) Включить / отключить"
    echo "2) Проверить сейчас"
    echo "3) Статус"
    echo "4) Заблокированные IP"
    echo "5) Логи"
    echo "6) Telegram"
    echo "7) Конфиг"
    echo "0) Выход"
    echo
    read -rp "Выбор: " CHOICE

    case "$CHOICE" in
      1) toggle_blocker; pause ;;
      2) run_once; pause ;;
      3) show_status; pause ;;
      4) show_banned; pause ;;
      5) show_logs; pause ;;
      6) telegram_menu ;;
      7) edit_config; pause ;;
      0) exit 0 ;;
      *) echo "Неверный пункт"; pause ;;
    esac
  done
}

main_menu
